        <item name="colorPrimary">#FF6B00</item>
        <item name="colorPrimaryDark">#E65C00</item>
        <item name="colorPrimaryVariant">#FF6B00</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary -->
        <item name="colorSecondary">#FF6B00</item>
