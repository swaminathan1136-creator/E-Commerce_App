<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/forgot_password_background"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="No worries! Enter your email and we’ll send you a reset link."
        android:textColor="#757575"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- Email Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Email Address"
        android:textColor="#424242"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/resetEmailInput"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_background"
        android:hint="Enter your email"
        android:inputType="textEmailAddress"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:singleLine="true"
        android:textSize="15sp"
        android:textColorHint="#AAAAAA" />

    <!-- Buttons -->
    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancelReset"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/forgot_password_btn_cancel_bg"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FF6B00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <View
            android:layout_width="14dp"
            android:layout_height="1dp" />

        <!-- Send Link Button -->
        <Button
            android:id="@+id/btnSendReset"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/forgot_password_btn_primary_bg"
            android:text="Send Link"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>